  "cards": [
    {
      "dot": "cyan",
      "title": "Primary request path",
      "items": [
        "Browser → nginx → SecurityMiddleware → FastAPI → QueryService.answer()",
        "answer() calls explain(), then generates only if the grounding guard passes",
        "ExplainabilityEngine drives 7 stages; each emits a ReasoningStep",
        "Response returns evidence, confidence, validity and a provenance id"
      ]
    },
    {
      "dot": "emerald",
      "title": "Retrieval + RAG pipeline",
      "items": [
        "VectorRetriever fuses three signals: dense 0.40, graph 0.35, hierarchy 0.25",
        "Query is embedded by BAAI/bge-m3 (1024d) before dense search",
        "Prompts are assembled in src/llm/prompts.py; evidence capped at 500 chars",
        "Confidence = 0.35 entailment + 0.30 relevance + 0.20 sufficiency + 0.15 retrieval"
      ]
    },
    {
      "dot": "violet",
      "title": "Knowledge sources",
      "items": [
        "Upload: pdfplumber/PyMuPDF → optional Tesseract OCR → clean → data/processed",
        "Hierarchy parser chunks by legal node (document/chapter/section/clause)",
        "Committed corpus is Indian Contract Act 1872 + Indian Penal Code, not BNS",
        "BNS 2023 exists only as a 6-item ungrounded gold probe in data/eval/gold"
      ]
    },
    {
      "dot": "amber",
      "title": "Data stores and reality check",
      "items": [
        "Qdrant is the only vector store; no ChromaDB anywhere in the tree",
        "Retrieval runs on InMemoryGraph, not Neo4j — Neo4jDriver has no QA caller",
        "Redis is declared in compose and settings but never imported by src/",
        "Provenance records persist to data/provenance with 30-day retention"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundaries",
      "items": [
        "nginx is the single public entry; only it publishes 80/443",
        "api exposes 8000 to the compose network only; compose publishes no port",
        "API-key auth and per-IP rate limiting are off by default (settings flags)",
        "LLM and embedding calls leave the network to third-party providers"
      ]
    }
  ]
