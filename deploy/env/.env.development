# ---------------------------------------------------------------------------
# Development environment template.
#
# Used by developers running the stack locally (docker compose -f
# docker-compose.yml -f docker-compose.override.yml up) or directly via
# `uvicorn src.main:app --reload`.
# ---------------------------------------------------------------------------

# Application
APP_NAME=explaintool
APP_VERSION=0.1.0
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=DEBUG

# Neo4j (internal Compose network)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Redis (internal Compose network)
REDIS_URL=redis://redis:6379/0

# Qdrant (internal Compose network)
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_IN_MEMORY=false

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]

# LLM / Answer Generation — offline mock by default (no network / keys needed).
LLM_PROVIDER=mock
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=800
LLM_TIMEOUT_SECONDS=60

# QA / Retrieval
QA_TOP_K=5
QA_CONFIDENCE_THRESHOLD=0.45
QA_PROVENANCE_DIR=data/provenance
QA_INDEX_IN_MEMORY=true

# Security middleware — relaxed in development.
API_KEY_AUTH_ENABLED=false
API_KEY=

# Request / rate limiting
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=0
REQUEST_MAX_BODY_BYTES=1048576

# Logging
LOG_ROTATION_ENABLED=false
LOG_MAX_BYTES=52428800
LOG_BACKUP_COUNT=10
