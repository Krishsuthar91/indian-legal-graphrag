# Application
APP_NAME=explaintool
APP_VERSION=0.1.0
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# LLM / Answer Generation (Module 7)
# provider: mock | openai | llama | mistral | qwen
LLM_PROVIDER=mock
LLM_MODEL=
# OpenAI-compatible endpoint (used by llama / qwen local serving, or openai/mistral APIs)
LLM_BASE_URL=
LLM_API_KEY=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=800
LLM_TIMEOUT_SECONDS=60

# QA / Retrieval (Module 7)
QA_TOP_K=5
QA_CONFIDENCE_THRESHOLD=0.45
QA_PROVENANCE_DIR=data/provenance
QA_INDEX_IN_MEMORY=true
# Phase 4: deterministic legal query expansion (retrieval-side only).
# Default is false (opt-in): corpus-aware expansion is a small net regression on
# the benchmark. Set to "true" to enable it explicitly for research/experiments.
QA_QUERY_EXPANSION_ENABLED=false

# Security middleware (Module 9)
API_KEY_AUTH_ENABLED=false
API_KEY=
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=120
REQUEST_MAX_BODY_BYTES=1048576

# Logging rotation (Module 9)
LOG_ROTATION_ENABLED=false
LOG_MAX_BYTES=52428800
LOG_BACKUP_COUNT=10
